# === Supabase (база данных, авторизация, хранилище) ===
# Project Settings -> API в панели Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретный ключ — ТОЛЬКО на сервере (Vercel env / .env.local). Не коммитить!
SUPABASE_SERVICE_ROLE_KEY=

# === Telegram (заявки на бронирование) ===
# Токен бота от @BotFather и ID чата/канала, куда слать заявки.
# Если не заполнено — приложение НЕ падает, заявка выводится в консоль сервера.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Аналитика (подключается только при наличии значения) ===
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# === Карты ===
# Опционально. Без ключа используется бесплатная карта OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
